diff --git a/r4d_gdn_lazy_update_k128_v128.h b/r4d_gdn_lazy_update_k128_v128.h
new file mode 100644
index 0000000..ea2aaa2
--- /dev/null
+++ b/r4d_gdn_lazy_update_k128_v128.h
@@ -0,0 +1,421 @@
+// r4d_gdn_lazy_update_k128_v128.h -- the GDN recurrent decode update with LAZY state snapshots.
+//
+// The eager kernel (r4d_gdn_recurrent_update_k128_v128.h) writes one full [V,K] state per
+// CANDIDATE token per head, because which candidate survives verification is only known after
+// the layer has run. Under speculative decode that is T snapshots per step per head, T slots per
+// sequence in the paged cache, and 55-88% of the kernel's time. This kernel keeps ONE state per
+// sequence (the "base": the state after every token that has been accepted so far) and a small
+// STASH of the last step's candidate inputs. Each step:
+//
+//   1. load the base from slot sidx[n, 0];
+//   2. replay the previous step's ACCEPTED candidates 1..naccept-1 from the stash (their
+//      post-conv q/k/v and gates were stashed last step, the accepted count only became known
+//      after verification) -- the same arithmetic as the eager update, no stores;
+//   3. run this step's candidate 0 (always accepted: it is the token the last verify sampled)
+//      and store the state after it back to slot sidx[n, 0] -- ONE snapshot per head per step;
+//   4. run candidates 1..T-1 from it, emitting outputs only, and stash their q/k/v/a/b for the
+//      next step's replay.
+//
+// The stash lives in the ssm-state area of the slot sidx[n, STASH_COL] (the one speculative block
+// the allocator still gives the request), laid out per v-head so a workgroup touches only its own
+// region. Its header records the base slot it was written against: a stash that does not match
+// the current base slot (first step after a prefill / prefix hit, or a slot the allocator moved)
+// is ignored, which makes "replay nothing" the fail-safe -- the base is then the last state that
+// was WRITTEN, which after a prefill is exactly right.
+//
+// Precision: the replayed tokens are applied in fp32 to the fp16 base, so a replayed token sees
+// ONE fewer storage rounding than the eager path gave it. Not bit-identical to eager; strictly
+// closer to the fp32 reference.
+#pragma once
+#include <hip/hip_runtime.h>
+#include "r4d.h"
+#include "r4d_gdn_wmma.h"
+#include "r4d_gdn_state.h"
+
+#define LZ_K    128
+#define LZ_V    128
+#define LZ_TPR    4            // threads per v row: a thread owns 32 of the 128 k elements
+#define LZ_HK   (LZ_K / LZ_TPR)
+#define LZ_THR  (LZ_V * LZ_TPR)  // 512 at VS=1
+#define LZ_MAXT   8            // candidates the stash holds per head (SPEC+1 at SPEC=7)
+// Per-head stash region, bytes: header 64 | a,b per candidate 64 | LZ_MAXT x (q 256 | k 256 | v 256)
+#define LZ_REGION     8192          // one stash region per (head, row-split workgroup)
+#define LZ_MAXVS         2
+#define LZ_HEAD_BYTES (LZ_REGION * LZ_MAXVS)
+#define LZ_HDR_MAGIC  0x4c5a5331u   // "LZS1"
+#define LZ_CAND_BYTES 768
+#define LZ_AB_OFF     64
+#define LZ_CAND_OFF   128
+
+struct lz_hdr { unsigned magic, count, base_slot, vs_w; };   // vs_w: row split at write time
+
+__device__ __forceinline__ float lz_softplus(float x, float thr) {
+  if (x > thr) return x;
+  return (x > 0.0f) ? (x + __logf(1.0f + __expf(-x))) : __logf(1.0f + __expf(x));
+}
+template <int ABF16>
+__device__ __forceinline__ float lz_ab(const void* p, size_t i) {
+  return ABF16 ? bf2f(((const unsigned short*)p)[i]) : ((const float*)p)[i];
+}
+// sum across the LZ_TPR lanes that share a row (consecutive lanes)
+__device__ __forceinline__ float lz_rowsum(float x) {
+  x += __shfl_xor(x, 1, 32);
+  x += __shfl_xor(x, 2, 32);
+  return x;
+}
+
+// One token's update of the thread's 32 state elements; returns this thread's partial of o.
+__device__ __forceinline__ float lz_step(float* h, const float* qq, const float* kk,
+                                         float vrow, float eg, float bt) {
+  float dot = 0.0f;
+#pragma unroll
+  for (int j = 0; j < LZ_HK; ++j) { h[j] *= eg; dot += h[j] * kk[j]; }
+  dot = lz_rowsum(dot);
+  const float u = (vrow - dot) * bt;
+  float on = 0.0f;
+#pragma unroll
+  for (int j = 0; j < LZ_HK; ++j) { h[j] += u * kk[j]; on += h[j] * qq[j]; }
+  return on;
+}
+
+// raw bf16 quarter-rows -> normalised fp32 (q scaled)
+__device__ __forceinline__ void lz_norm(const uint4* cq, const uint4* ck, float* qq, float* kk,
+                                        float scale) {
+#pragma unroll
+  for (int j = 0; j < LZ_HK / 8; ++j) {
+    const unsigned short* sq = (const unsigned short*)&cq[j];
+    const unsigned short* sk = (const unsigned short*)&ck[j];
+#pragma unroll
+    for (int e = 0; e < 8; ++e) { qq[8 * j + e] = bf2f(sq[e]); kk[8 * j + e] = bf2f(sk[e]); }
+  }
+  float sq = 0.0f, sk = 0.0f;
+#pragma unroll
+  for (int j = 0; j < LZ_HK; ++j) { sq += qq[j] * qq[j]; sk += kk[j] * kk[j]; }
+  sq = lz_rowsum(sq); sk = lz_rowsum(sk);
+  const float qs = __frsqrt_rn(sq + 1e-6f) * scale, ks = __frsqrt_rn(sk + 1e-6f);
+#pragma unroll
+  for (int j = 0; j < LZ_HK; ++j) { qq[j] *= qs; kk[j] *= ks; }
+}
+
+// VS: workgroups per head (each owns 128/VS v rows). At one sequence (48 heads on 64 CUs) VS=2
+// fills the machine. Four threads per row keep the per-thread state at 32 elements, which is
+// what lets the NEXT token's raw q/k/v/a/b be fetched before this token's arithmetic starts
+// (software prefetch) without spilling: the per-token chain is latency-bound.
+template <int ABF16, int STDT, int VS>
+__global__ __launch_bounds__(LZ_THR / VS)
+void r4d_gdn_lazy_update_kernel(const unsigned short* __restrict__ q,
+                                const unsigned short* __restrict__ k,
+                                const unsigned short* __restrict__ v,
+                                const void* __restrict__ av,
+                                const void* __restrict__ bv, long ab_stride,
+                                const float* __restrict__ A_log,
+                                const float* __restrict__ dt_bias,
+                                gdn_state_t<STDT>* __restrict__ state,
+                                long st_slot, long st_head,
+                                unsigned short* __restrict__ o,
+                                const int* __restrict__ cu,
+                                const int* __restrict__ sidx, long sidx_stride,
+                                const int* __restrict__ naccept,
+                                int H, int Hg, int stash_col, float scale, float sp_thr)
+{
+  constexpr int NR = LZ_V / VS;
+  const int n = blockIdx.x, hv = blockIdx.y;
+  const int bos = cu[n], T = cu[n + 1] - bos;
+  if (T <= 0) return;
+  const int tid = threadIdx.x;
+  const int lrow = tid / LZ_TPR, quarter = tid % LZ_TPR;
+  const int row = lrow + (VS > 1 ? blockIdx.z * NR : 0), k0 = quarter * LZ_HK;
+  const int hk = hv / (H / Hg);
+  const int base_slot = sidx[(size_t)n * sidx_stride];
+  const int stash_slot = sidx[(size_t)n * sidx_stride + stash_col];
+  if (base_slot <= 0 || stash_slot <= 0) return;           // NULL_BLOCK_ID: nothing scheduled
+
+  // The stash for head hv lives in head hv's own state region of the stash slot (st_head
+  // elements = 32 KB at f16, more than the 8 KB it needs), so a workgroup only ever touches its
+  // own head's bytes -- which is what makes the in-place materialisation below safe.
+  // Region layout: LZ_MAXVS regions of LZ_REGION bytes per head. Region z is owned by the
+  // row-split workgroup z: it carries a header, the gates and the q/k entries (identical copies
+  // in every region) and the v entries of ITS rows. A writer that runs unsplit (VS=1) fills
+  // every region, so a reader of either split always finds its own header -- and never shares
+  // a byte with the other workgroup of the same head (the two are not ordered by anything).
+  unsigned char* stash0 = (unsigned char*)(state + (size_t)stash_slot * st_slot
+                                           + (size_t)hv * st_head);
+  const int z = (VS > 1) ? (int)blockIdx.z : 0;
+  unsigned char* stash = stash0 + (size_t)z * LZ_REGION;
+  __shared__ lz_hdr s_hdr;
+  if (tid == 0) s_hdr = *(const lz_hdr*)stash;
+  __syncthreads();
+  const int vs_w = (s_hdr.vs_w == 2) ? 2 : 1;
+  const unsigned char* vreg = stash0 + (size_t)((row * vs_w) / LZ_V) * LZ_REGION;   // v rows of this row
+  // Candidate 0 of a step is ALWAYS accepted (it is the token the previous verify sampled), so
+  // its state is stored as the base right after it runs, and the replay covers only candidates
+  // 1 .. naccept-1 of the previous step: one token less of serial work per step. The stash holds
+  // candidates 1..T-1 at entries 0..T-2.
+  int r = 0;
+  if (s_hdr.magic == LZ_HDR_MAGIC && (int)s_hdr.base_slot == base_slot) {
+    r = naccept ? naccept[n] - 1 : 0;
+    if (r > (int)s_hdr.count) r = (int)s_hdr.count;
+    if (r > LZ_MAXT - 1) r = LZ_MAXT - 1;
+    if (r < 0) r = 0;
+  }
+
+  float h[LZ_HK];
+  gdn_state_load<STDT, LZ_HK>(h, state + (size_t)base_slot * st_slot + (size_t)hv * st_head
+                                     + (size_t)row * LZ_K + k0);
+  const float alog = __expf(A_log[hv]), dtb = dt_bias[hv];
+  float qq[LZ_HK], kk[LZ_HK];
+  uint4 rq[LZ_HK / 8], rk[LZ_HK / 8];      // raw bf16 of the token being prefetched
+  unsigned short rv = 0; float ra = 0.f, rb = 0.f;
+
+  const float* ab_st = (const float*)(stash + LZ_AB_OFF);
+#define LZ_FETCH_STASH(i)                                                                     \
+  do { const unsigned char* c_ = stash + LZ_CAND_OFF + (size_t)(i) * LZ_CAND_BYTES;          \
+       const uint4* sq_ = (const uint4*)(c_ + (size_t)k0 * 2);                               \
+       const uint4* sk_ = (const uint4*)(c_ + 256 + (size_t)k0 * 2);                         \
+       _Pragma("unroll") for (int j = 0; j < LZ_HK / 8; ++j) { rq[j] = sq_[j]; rk[j] = sk_[j]; } \
+       rv = ((const unsigned short*)(vreg + LZ_CAND_OFF + (size_t)(i) * LZ_CAND_BYTES + 512))[row]; \
+       ra = ab_st[2 * (i)]; rb = ab_st[2 * (i) + 1]; } while (0)
+#define LZ_FETCH_TOK(t)                                                                       \
+  do { const int tok_ = bos + (t);                                                            \
+       const uint4* sq_ = (const uint4*)(q + ((size_t)tok_ * Hg + hk) * LZ_K + k0);          \
+       const uint4* sk_ = (const uint4*)(k + ((size_t)tok_ * Hg + hk) * LZ_K + k0);          \
+       _Pragma("unroll") for (int j = 0; j < LZ_HK / 8; ++j) { rq[j] = sq_[j]; rk[j] = sk_[j]; } \
+       rv = v[((size_t)tok_ * H + hv) * LZ_V + row];                                          \
+       ra = lz_ab<ABF16>(av, (size_t)tok_ * ab_stride + hv);                                 \
+       rb = lz_ab<ABF16>(bv, (size_t)tok_ * ab_stride + hv); } while (0)
+
+  // ---- 2. replay the accepted candidates of the previous step ---------------------------------
+  if (r > 0) LZ_FETCH_STASH(0); else LZ_FETCH_TOK(0);
+  for (int i = 0; i < r; ++i) {
+    uint4 cq[LZ_HK / 8], ck[LZ_HK / 8];
+#pragma unroll
+    for (int j = 0; j < LZ_HK / 8; ++j) { cq[j] = rq[j]; ck[j] = rk[j]; }
+    const float cv = bf2f(rv), ca = ra, cb = rb;
+    if (i + 1 < r) LZ_FETCH_STASH(i + 1); else LZ_FETCH_TOK(0);
+    lz_norm(cq, ck, qq, kk, scale);
+    const float g  = -alog * lz_softplus(ca + dtb, sp_thr);
+    const float bt = 1.0f / (1.0f + __expf(-cb));
+    (void)lz_step(h, qq, kk, cv, __expf(g), bt);
+  }
+  __syncthreads();                       // the stash we read is overwritten below
+
+  // ---- 4. this step's candidates: outputs only, inputs stashed for the next replay ------------
+  for (int t = 0; t < T; ++t) {
+    const int tok = bos + t;
+    uint4 cq[LZ_HK / 8], ck[LZ_HK / 8];
+#pragma unroll
+    for (int j = 0; j < LZ_HK / 8; ++j) { cq[j] = rq[j]; ck[j] = rk[j]; }
+    const unsigned short cvraw = rv; const float ca = ra, cb = rb;
+    if (t + 1 < T) LZ_FETCH_TOK(t + 1);
+    if (t >= 1 && t <= LZ_MAXT - 1) {
+      const int e = t - 1;
+      // q/k quarter-rows and gates: this workgroup's region, plus every other region when it
+      // runs unsplit (a later split reader owns region 1). Row e's four threads carry q/k.
+#pragma unroll
+      for (int rg = 0; rg < LZ_MAXVS; ++rg) {
+        if (VS > 1 && rg != z) continue;
+        unsigned char* c = stash0 + (size_t)rg * LZ_REGION + LZ_CAND_OFF + (size_t)e * LZ_CAND_BYTES;
+        if (lrow == (e % NR)) {
+          uint4* dq = (uint4*)(c + (size_t)k0 * 2); uint4* dk = (uint4*)(c + 256 + (size_t)k0 * 2);
+#pragma unroll
+          for (int j = 0; j < LZ_HK / 8; ++j) { dq[j] = cq[j]; dk[j] = ck[j]; }
+        }
+        if (tid == 0) { float* abw = (float*)(stash0 + (size_t)rg * LZ_REGION + LZ_AB_OFF); abw[2 * e] = ca; abw[2 * e + 1] = cb; }
+      }
+      // v: row `row` lands in region (row * VS / 128) -- this workgroup's own region
+      if (quarter == 0) ((unsigned short*)(stash + LZ_CAND_OFF + (size_t)e * LZ_CAND_BYTES + 512))[row] = cvraw;
+    }
+    lz_norm(cq, ck, qq, kk, scale);
+    const float g  = -alog * lz_softplus(ca + dtb, sp_thr);
+    const float bt = 1.0f / (1.0f + __expf(-cb));
+    float on = lz_step(h, qq, kk, bf2f(cvraw), __expf(g), bt);
+    on = lz_rowsum(on);
+    if (quarter == 0) o[((size_t)tok * H + hv) * LZ_V + row] = f2bf(on);
+    // ---- 3. candidate 0 is always accepted: the state after it is the new base ---------------
+    if (t == 0)
+      gdn_state_store<STDT, LZ_HK>(state + (size_t)base_slot * st_slot + (size_t)hv * st_head
+                                         + (size_t)row * LZ_K + k0, h);
+  }
+  __syncthreads();
+  if (tid == 0) {
+    lz_hdr hd; hd.magic = LZ_HDR_MAGIC; hd.count = (T - 1) < (LZ_MAXT - 1) ? (T - 1) : (LZ_MAXT - 1);
+    hd.base_slot = (unsigned)base_slot; hd.vs_w = (unsigned)VS;
+#pragma unroll
+    for (int rg = 0; rg < LZ_MAXVS; ++rg) {
+      if (VS > 1 && rg != z) continue;
+      *(lz_hdr*)(stash0 + (size_t)rg * LZ_REGION) = hd;
+    }
+  }
+#undef LZ_FETCH_STASH
+#undef LZ_FETCH_TOK
+}
+
+// ---- materialise: the state after candidate `count` of the previous step, written to a slot ---
+//
+// This is what vLLM's align-mode state copies need from a lazy cache. The eager cache copies a
+// per-candidate snapshot (column src + bias); here the same state is base + replay of stash
+// entries 0 .. count-1 (candidates 1 .. count). Two callers, both GPU-driven so nothing syncs:
+//   MODE 0 (pre-forward migration): request rows whose running block moved (src_col != dst_col):
+//     base = bt[src_col], stash = bt[src_col + 1], count = token_bias (= naccept - 1),
+//     dst = bt[dst_col]. dst IS the old stash block (the window slid by one), so the replay
+//     reads the stash before the state overwrites it (one barrier). The block after dst is the
+//     new stash block: its headers are invalidated so a stale stash can never replay.
+//   MODE 1 (post-step checkpoint): rows whose accepted tokens crossed a block boundary:
+//     count = aligned_new_computed - running, dst = the aligned block (== src when the boundary
+//     token is the last accepted one -- then vLLM resets naccept to 1 and the base is complete).
+// Grid (num_reqs, H, num_temporal_states); every state tensor / block table / gate vector comes
+// through pointer tables so all 48 layers are one launch.
+struct lz_tables {
+  const long long* state_ptrs;     // [n_states] temporal state tensors
+  const long long* slot_strides;   // [n_states] bytes per slot
+  const int*       group_idx;      // [n_states] mamba group -> block table
+  const long long* alog_ptrs;      // [n_states] A_log (fp32[H])
+  const long long* dtb_ptrs;       // [n_states] dt_bias (fp32[H])
+  const long long* bt_ptrs;        // [n_groups] int32 block tables [rows, cols]
+  long long        bt_stride_req;  // elements between rows
+  const int*       idx_mapping;    // [num_reqs] batch row -> request slot, or null
+};
+
+template <int STDT>
+__global__ __launch_bounds__(LZ_THR)
+void r4d_gdn_lazy_materialize_kernel(lz_tables tb, int mode,
+                                     const int* __restrict__ state_idx,     // dst col (mode 0) / running col (mode 1)
+                                     const int* __restrict__ src_col,       // mode 0
+                                     const int* __restrict__ token_bias,    // mode 0
+                                     const int* __restrict__ num_accepted,  // mode 1
+                                     const int* __restrict__ new_computed,  // mode 1
+                                     int block_size, int H, int Hg, long st_head,
+                                     float scale, float sp_thr)
+{
+  const int b = blockIdx.x, hv = blockIdx.y, si = blockIdx.z;
+  const int req = tb.idx_mapping ? tb.idx_mapping[b] : b;
+  if (req < 0) return;
+  int base_col, dst_col, count;
+  if (mode == 0) {
+    base_col = src_col[req]; dst_col = state_idx[req];
+    if (base_col < 0 || base_col == dst_col) return;
+    count = token_bias[req];
+  } else {
+    const int nacc = num_accepted[req];
+    base_col = state_idx[req];
+    const int newc = new_computed[req];
+    const int running = newc - nacc + 1;
+    const int aligned = (newc / block_size) * block_size;
+    if (aligned < running) return;
+    count = aligned - running;
+    dst_col = aligned / block_size - 1;
+    if (dst_col == base_col && count == 0) return;
+  }
+  const int* bt = (const int*)tb.bt_ptrs[tb.group_idx[si]] + (size_t)b * tb.bt_stride_req;
+  const int base_slot = bt[base_col], stash_slot = bt[base_col + 1], dst_slot = bt[dst_col];
+  if (base_slot <= 0 || stash_slot <= 0 || dst_slot <= 0) return;
+  gdn_state_t<STDT>* state = (gdn_state_t<STDT>*)tb.state_ptrs[si];
+  const long st_slot = tb.slot_strides[si] / (long)sizeof(gdn_state_t<STDT>);
+  const float* A_log = (const float*)tb.alog_ptrs[si];
+  const float* dt_bias = (const float*)tb.dtb_ptrs[si];
+
+  const int tid = threadIdx.x;
+  const int row = tid / LZ_TPR, quarter = tid % LZ_TPR, k0 = quarter * LZ_HK;
+  const int hk = hv / (H / Hg);
+  unsigned char* stash = (unsigned char*)(state + (size_t)stash_slot * st_slot + (size_t)hv * st_head);
+  __shared__ lz_hdr s_hdr;
+  if (tid == 0) s_hdr = *(const lz_hdr*)stash;          // region 0
+  __syncthreads();
+  const int vs_w = (s_hdr.vs_w == 2) ? 2 : 1;
+  const unsigned char* vreg = stash + (size_t)((row * vs_w) / LZ_V) * LZ_REGION;
+  int r = 0;
+  if (s_hdr.magic == LZ_HDR_MAGIC && (int)s_hdr.base_slot == base_slot) {
+    r = count;
+    if (r > (int)s_hdr.count) r = (int)s_hdr.count;
+    if (r > LZ_MAXT - 1) r = LZ_MAXT - 1;
+    if (r < 0) r = 0;
+  }
+  float h[LZ_HK];
+  gdn_state_load<STDT, LZ_HK>(h, state + (size_t)base_slot * st_slot + (size_t)hv * st_head
+                                     + (size_t)row * LZ_K + k0);
+  const float alog = __expf(A_log[hv]), dtb = dt_bias[hv];
+  float qq[LZ_HK], kk[LZ_HK];
+  const float* ab_st = (const float*)(stash + LZ_AB_OFF);
+  for (int i = 0; i < r; ++i) {
+    const unsigned char* c = stash + LZ_CAND_OFF + (size_t)i * LZ_CAND_BYTES;
+    uint4 cq[LZ_HK / 8], ck[LZ_HK / 8];
+    const uint4* sq = (const uint4*)(c + (size_t)k0 * 2); const uint4* sk = (const uint4*)(c + 256 + (size_t)k0 * 2);
+#pragma unroll
+    for (int j = 0; j < LZ_HK / 8; ++j) { cq[j] = sq[j]; ck[j] = sk[j]; }
+    const float cv = bf2f(((const unsigned short*)(vreg + LZ_CAND_OFF + (size_t)i * LZ_CAND_BYTES + 512))[row]);
+    const float ca = ab_st[2 * i], cb = ab_st[2 * i + 1];
+    lz_norm(cq, ck, qq, kk, scale);
+    const float g  = -alog * lz_softplus(ca + dtb, sp_thr);
+    const float bt_ = 1.0f / (1.0f + __expf(-cb));
+    (void)lz_step(h, qq, kk, cv, __expf(g), bt_);
+  }
+  __syncthreads();                       // every stash read of this head is done before dst is written
+  gdn_state_store<STDT, LZ_HK>(state + (size_t)dst_slot * st_slot + (size_t)hv * st_head
+                                     + (size_t)row * LZ_K + k0, h);
+  if (mode == 0 && tid == 0) {
+    // the block after the new running block is the new stash block: its header must not replay
+    const int new_stash = bt[dst_col + 1];
+    if (new_stash > 0) {
+      unsigned char* ns = (unsigned char*)(state + (size_t)new_stash * st_slot + (size_t)hv * st_head);
+      lz_hdr z; z.magic = 0; z.count = 0; z.base_slot = 0; z.vs_w = 0;
+      for (int rg = 0; rg < LZ_MAXVS; ++rg) *(lz_hdr*)(ns + (size_t)rg * LZ_REGION) = z;
+    }
+  }
+}
+
+template <int STDT>
+static int lz_materialize_launch(
+    const void* state_ptrs, const void* slot_strides, const void* group_idx,
+    const void* alog_ptrs, const void* dtb_ptrs, const void* bt_ptrs, long bt_stride_req,
+    const void* idx_mapping, int mode, const void* state_idx, const void* src_col,
+    const void* token_bias, const void* num_accepted, const void* new_computed,
+    int block_size, int num_reqs, int n_states, int H, int Hg, int K, int V, long st_head,
+    float scale, float softplus_thr, void* stream)
+{
+  if (K != LZ_K || V != LZ_V) return -1;
+  if (H % Hg) return -2;
+  if (num_reqs <= 0 || n_states <= 0) return 0;
+  lz_tables tb;
+  tb.state_ptrs = (const long long*)state_ptrs; tb.slot_strides = (const long long*)slot_strides;
+  tb.group_idx = (const int*)group_idx; tb.alog_ptrs = (const long long*)alog_ptrs;
+  tb.dtb_ptrs = (const long long*)dtb_ptrs; tb.bt_ptrs = (const long long*)bt_ptrs;
+  tb.bt_stride_req = bt_stride_req; tb.idx_mapping = (const int*)idx_mapping;
+  dim3 grid(num_reqs, H, n_states), blk(LZ_THR);
+  hipLaunchKernelGGL((r4d_gdn_lazy_materialize_kernel<STDT>), grid, blk, 0, (hipStream_t)stream,
+                     tb, mode, (const int*)state_idx, (const int*)src_col, (const int*)token_bias,
+                     (const int*)num_accepted, (const int*)new_computed, block_size, H, Hg,
+                     st_head, scale, softplus_thr);
+  return (int)hipGetLastError();
+}
+
+template <int STDT>
+static int lz_launch(
+    const void* q, const void* k, const void* v, const void* a, const void* b,
+    long ab_stride, int ab_is_bf16, const void* A_log, const void* dt_bias, void* state,
+    long state_slot_stride, long state_head_stride, void* o, const void* cu,
+    const void* ssm_state_indices, long indices_stride, const void* num_accepted,
+    int N, int H, int Hg, int K, int V, int stash_col, float scale, float softplus_thr,
+    void* stream)
+{
+  if (K != LZ_K || V != LZ_V) return -1;
+  if (H % Hg) return -2;
+  if ((size_t)state_head_stride * sizeof(gdn_state_t<STDT>) < LZ_HEAD_BYTES) return -4;
+  // Fill the machine at small N: 48 (seq, head) items on 64 CUs split their rows in two.
+  const int vs = (N * H < 64) ? 2 : 1;
+  dim3 grid(N, H, vs), blk(LZ_THR / vs);
+#define LZ_LAUNCH(AB)                                                                         \
+  do { if (vs == 2) LZ_LAUNCH_V(AB, 2); else LZ_LAUNCH_V(AB, 1); } while (0)
+#define LZ_LAUNCH_V(AB, VSC)                                                                  \
+  hipLaunchKernelGGL((r4d_gdn_lazy_update_kernel<AB, STDT, VSC>), grid, blk, 0, (hipStream_t)stream,\
+                     (const unsigned short*)q, (const unsigned short*)k,                      \
+                     (const unsigned short*)v, a, b, ab_stride,                               \
+                     (const float*)A_log, (const float*)dt_bias,                              \
+                     (gdn_state_t<STDT>*)state, state_slot_stride, state_head_stride,         \
+                     (unsigned short*)o, (const int*)cu, (const int*)ssm_state_indices,       \
+                     indices_stride, (const int*)num_accepted, H, Hg, stash_col, scale,       \
+                     softplus_thr)
+  if (ab_is_bf16) LZ_LAUNCH(1); else LZ_LAUNCH(0);
+#undef LZ_LAUNCH_V
+#undef LZ_LAUNCH
+  return (int)hipGetLastError();
+}
