diff --git a/r4d_gdn_state.h b/r4d_gdn_state.h
new file mode 100644
index 0000000..4b25df5
--- /dev/null
+++ b/r4d_gdn_state.h
@@ -0,0 +1,100 @@
+// r4d_gdn_state.h -- how a GDN temporal state lands in the paged cache.
+//
+// The [V,K] temporal state is the whole cost of the decode-side GDN kernels: one snapshot per
+// candidate token per head, because which candidate survives verification is not known until after
+// the layer has run. Its dtype is therefore a template parameter shared by the recurrent and fused
+// updates rather than a copy of the access code in each:
+//
+//   R4D_ST_F32  = 0   fp32, what this model's HF config asks for (mamba_ssm_dtype=float32), 64 KB
+//   R4D_ST_BF16 = 1   bf16, --mamba-ssm-cache-dtype=bfloat16, 32 KB
+//   R4D_ST_F16  = 2   f16,  --mamba-ssm-cache-dtype=float16,  32 KB
+//
+// THE ACCUMULATOR IS FP32 IN ALL THREE. Only what lands in the cache narrows, so a step's
+// arithmetic is unchanged and the error is one storage rounding per candidate -- bf16 measures at
+// rms 1.7e-3 on the state against bf16's own 3.9e-3 resolution.
+//
+// bf16 vs f16 is not a wash on this part, and f16 wins on both counts that matter here:
+//
+//   * PRECISION. f16 carries 10 mantissa bits to bf16's 7 (+implicit), so ~8x finer resolution on
+//     a state that round-trips through storage every decode step.
+//   * COST. Equal, at 3 VALU per pair. gfx1201 has no bf16 convert at all (f2bf2 is 2 adds +
+//     v_perm) and no packed round-to-nearest f16 convert either, so f16 is 2 v_cvt_f16_f32 plus
+//     the same pack. The one-instruction v_cvt_pkrtz exists but rounds toward zero; see r4d_f2h2
+//     for why that trade is not available here.
+//
+// What f16 gives up is exponent range: max 65504 and min normal 6.1e-5, where bf16 has fp32's.
+// The state is a leaky integrator of l2-normalised outer products and sits around O(1e-2), so the
+// top is not in reach; the bottom rounds small tails to subnormal/zero, which the decay would have
+// taken anyway. bf16 stays available for anything that does turn out to need the range.
+#pragma once
+#include "r4d_gdn_wmma.h"
+
+#define R4D_ST_F32  0
+#define R4D_ST_BF16 1
+#define R4D_ST_F16  2
+
+
+template <int STDT> struct gdn_state_traits;
+template <> struct gdn_state_traits<R4D_ST_F32>  { typedef float          type; };
+template <> struct gdn_state_traits<R4D_ST_BF16> { typedef unsigned short type; };
+template <> struct gdn_state_traits<R4D_ST_F16>  { typedef unsigned short type; };
+template <int STDT> using gdn_state_t = typename gdn_state_traits<STDT>::type;
+
+// Round-to-NEAREST, deliberately NOT v_cvt_pkrtz. pkrtz packs a pair in ONE instruction, but it
+// rounds toward ZERO, and a biased rounding is the one kind of error this state does not forgive:
+// random error decays out of a leaky integrator within its horizon, a systematic magnitude loss
+// does not -- it just changes the effective decay from d to d(1-b), so the state settles at
+// (1-d)/(1-d(1-b)) of its true size. Measured per-step bias was -2.4e-4 with pkrtz against -3.7e-6
+// for bf16, which at the longest-memory heads here (decay 0.9973, ~376 token horizon) compounds to
+// ~8% state deflation. Two v_cvt_f16_f32 plus the pack is 3 instructions -- the same as bf16's
+// f2bf2 -- so this keeps fp16's 3 extra mantissa bits at bf16's cost and bf16's lack of bias.
+__device__ __forceinline__ unsigned r4d_f2h2(float a, float b) {
+  union { __fp16 h; unsigned short u; } qa, qb;
+  qa.h = (__fp16)a; qb.h = (__fp16)b;          // C++ cast = current round mode = RTNE
+  return __builtin_amdgcn_perm((unsigned)qb.u, (unsigned)qa.u, 0x05040100u);  // {b_lo16, a_lo16}
+}
+__device__ __forceinline__ float r4d_h2f(unsigned short h) {
+  union { unsigned short u; __fp16 h; } q; q.u = h; return (float)q.h;
+}
+
+// HK elements, contiguous in k. Every form is 16-byte accesses over one run: fp32 is four float4
+// over 256 bytes, the 16-bit forms are eight-at-a-time over 128.
+template <int STDT, int HK>
+__device__ __forceinline__ void gdn_state_load(float* h, const gdn_state_t<STDT>* p) {
+  if (STDT == R4D_ST_F32) {
+    const float* q = (const float*)p;
+#pragma unroll
+    for (int j = 0; j < HK; j += 4) *(float4*)&h[j] = *(const float4*)(q + j);
+  } else {
+    const unsigned short* q = (const unsigned short*)p;
+#pragma unroll
+    for (int j = 0; j < HK; j += 8) {
+      const uint4 w = *(const uint4*)(q + j);
+      const unsigned short* sw = (const unsigned short*)&w;
+#pragma unroll
+      for (int e = 0; e < 8; ++e)
+        h[j + e] = (STDT == R4D_ST_BF16) ? bf2f(sw[e]) : r4d_h2f(sw[e]);
+    }
+  }
+}
+
+template <int STDT, int HK>
+__device__ __forceinline__ void gdn_state_store(gdn_state_t<STDT>* p, const float* h) {
+  if (STDT == R4D_ST_F32) {
+    float* q = (float*)p;
+#pragma unroll
+    for (int j = 0; j < HK; j += 4) *(float4*)(q + j) = *(const float4*)&h[j];
+  } else if (STDT == R4D_ST_BF16) {
+    unsigned short* q = (unsigned short*)p;
+#pragma unroll
+    for (int j = 0; j < HK; j += 8)
+      *(uint4*)(q + j) = make_uint4(f2bf2(h[j], h[j + 1]), f2bf2(h[j + 2], h[j + 3]),
+                                    f2bf2(h[j + 4], h[j + 5]), f2bf2(h[j + 6], h[j + 7]));
+  } else {
+    unsigned short* q = (unsigned short*)p;
+#pragma unroll
+    for (int j = 0; j < HK; j += 8)
+      *(uint4*)(q + j) = make_uint4(r4d_f2h2(h[j], h[j + 1]), r4d_f2h2(h[j + 2], h[j + 3]),
+                                    r4d_f2h2(h[j + 4], h[j + 5]), r4d_f2h2(h[j + 6], h[j + 7]));
+  }
+}
