+    if (half == 0) o[((size_t)tok * H + hv) * RU_V + row] = f2bf(on);
+
+    const int so = sidx[(size_t)n * sidx_stride + t];
+    if (so > 0) {
+      gdn_state_t<STDT>* p = state + (size_t)so * st_slot + (size_t)hv * st_head
+               + (size_t)row * RU_K + k0;
+      gdn_state_store<STDT, RU_HK>(p, h);
+    }
+  }
+}
+
+template <int STDT>
+static int ru_launch(
+    const void* q, const void* k, const void* v, const void* a, const void* b,
+    long ab_stride, int ab_is_bf16, const void* A_log, const void* dt_bias, void* state,
+    long state_slot_stride, long state_head_stride, void* o, const void* cu,
+    const void* ssm_state_indices, long indices_stride, const void* num_accepted,
+    const void* z_gate, const void* norm_weight, float norm_eps, int norm_act,
+    int N, int H, int Hg, int K, int V, float scale, float softplus_thr, void* stream)
+{
+  if (K != RU_K || V != RU_V) return -1;
+  if (H % Hg) return -2;
+  const int nm0 = (z_gate && norm_weight) ? 1 : 0;
+  // Fill the machine: at one sequence the (N, H) grid is 24 workgroups. Split a head's v rows
+  // until there are at least 64 workgroups, but never past four (that is 64 threads, two waves).
+  int vs = 1;
+  if (!nm0) { const int want = (64 + N * H - 1) / (N * H);
+              vs = want >= 4 ? 4 : (want >= 2 ? 2 : 1);
+              if (vs > VSMAX) vs = VSMAX; }
+  dim3 grid(N, H, vs), blk(RU_V / vs * 2);
+#define RU_LAUNCH(AB, NM, VSC)                                                                \
+  hipLaunchKernelGGL((r4d_gdn_recurrent_update_kernel<AB, NM, VSC, STDT>), grid, blk, 0,            \
+                     (hipStream_t)stream,                                                     \
+                     (const unsigned short*)q, (const unsigned short*)k,                      \
+                     (const unsigned short*)v, a, b, ab_stride,                               \
+                     (const float*)A_log, (const float*)dt_bias,                              \
+                     (gdn_state_t<STDT>*)state,                                            \
+                     state_slot_stride, state_head_stride,                                    \
+                     (unsigned short*)o, (const int*)cu, (const int*)ssm_state_indices,       \
+                     indices_stride, (const int*)num_accepted,                                \
+                     (const unsigned short*)z_gate, (const float*)norm_weight, norm_eps,      \
+                     norm_act, H, Hg, scale, softplus_thr)
+#define RU_PICKV(AB)                                                                          \
+  do { if (vs == 4)      RU_LAUNCH(AB, 0, 4);                                                 \
+       else if (vs == 2) RU_LAUNCH(AB, 0, 2);                                                 \
+       else              RU_LAUNCH(AB, 0, 1); } while (0)
+  if (ab_is_bf16) { if (nm0) RU_LAUNCH(1, 1, 1); else RU_PICKV(1); }
+  else            { if (nm0) RU_LAUNCH(0, 1, 1); else RU_PICKV(0); }
+#undef RU_PICKV
+#undef RU_LAUNCH
+  return (int)hipGetLastError();
+}
diff --git a/r4d_gdn_recurrent_update_k128_v128_bf16_bf16state.hip b/r4d_gdn_recurrent_update_k128_v128_bf16_bf16state.hip
new file mode 100644
index 0000000..1d20325
--- /dev/null
+++ b/r4d_gdn_recurrent_update_k128_v128_bf16_bf16state.hip
@@ -0,0 +1,36 @@
+// r4d_gdn_recurrent_update_k128_v128_bf16_bf16state.hip -- the GDN recurrent update against a
+// **bf16** paged state cache, selected with --mamba-ssm-cache-dtype=bfloat16 (which vLLM lets the
+// user set over the model config's mamba_ssm_dtype, with a warning).
+//
+// Halving the state halves the whole cost of this kernel, because the state traffic IS the cost:
+// one [V,K] snapshot per candidate token per head. Measured against the fp32 entry at H=24 v-heads
+// per rank (TP=2), conv+recurrent pair, us/call:
+//
+//     N=1 T=8   31.4 -> 26.5   (-16%)      N=8 T=5   60.3 -> 44.3   (-26%)
+//     N=4 T=6   41.7 -> 32.6   (-22%)      N=8 T=8  168.9 -> 60.9   (-64%)
+//
+// The last row is the one that matters: at fp32 an eight-wide draft at batch eight puts 100.7 MB
+// of state against a 64 MB last level and falls off a capacity cliff; at bf16 it is 50.3 MB and
+// costs what a FIVE-wide draft costs today. See the header for the accumulator/precision split.
+//
+// The kernel itself lives in r4d_gdn_recurrent_update_k128_v128.h; this unit only instantiates it
+// for the bf16 state and exports the entry point. Its fp32 sibling is
+// r4d_gdn_recurrent_update_k128_v128_bf16_fp32state.hip. Two entry points rather than a runtime
+// flag because the state dtype IS part of the geometry: a caller that hands an fp32 cache to the
+// bf16 entry reads half the bytes it should and faults, so the registry makes state_dtype a
+// matched constraint and select() can never return the wrong one.
+#include "r4d_gdn_recurrent_update_k128_v128.h"
+
+extern "C" int r4d_gdn_recurrent_update_k128_v128_bf16_bf16state(
+    const void* q, const void* k, const void* v, const void* a, const void* b,
+    long ab_stride, int ab_is_bf16, const void* A_log, const void* dt_bias, void* state,
+    long state_slot_stride, long state_head_stride, void* o, const void* cu,
+    const void* ssm_state_indices, long indices_stride, const void* num_accepted,
+    const void* z_gate, const void* norm_weight, float norm_eps, int norm_act,
+    int N, int H, int Hg, int K, int V, float scale, float softplus_thr, void* stream)
+{
+  return ru_launch<R4D_ST_BF16>(q, k, v, a, b, ab_stride, ab_is_bf16, A_log, dt_bias, state,
+                      state_slot_stride, state_head_stride, o, cu, ssm_state_indices,
+                      indices_stride, num_accepted, z_gate, norm_weight, norm_eps, norm_act,
+                      N, H, Hg, K, V, scale, softplus_thr, stream);
+}
